# EAS runs from the Git repository root in this pnpm monorepo. Keep the
# archive intentionally small: the remote build only needs the mobile app,
# its generated API client workspace package, and the shared guard scripts.
/*

# Root package-manager files required to install the workspace
!/.easignore
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/.npmrc
!/patches/
!/patches/**

# The Expo application being built
!/artifacts/
!/artifacts/thaddi-mobile/
!/artifacts/thaddi-mobile/**

# Workspace packages imported by the mobile app
!/lib/
!/lib/api-client-react/
!/lib/api-client-react/**
!/scripts/
!/scripts/**

# Never upload dependencies, native output, caches, or local build products.
**/node_modules/
**/.expo/
**/android/
**/ios/
**/dist/
**/static-build/
**/coverage/
**/test-results/
**/*.tsbuildinfo
**/*.log
**/*.apk
**/*.aab
**/*.zip
**/*.tar.gz
