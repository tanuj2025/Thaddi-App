modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "i18n"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rtl"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "i18n"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thaddi run check:i18n"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "rtl"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thaddi run check:rtl && pnpm --filter @workspace/mockup-sandbox run check:rtl"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thaddi run test:i18n && pnpm --filter @workspace/thaddi run test:password && pnpm --filter @workspace/thaddi run test:nav && pnpm --filter @workspace/thaddi run test:match && pnpm --filter @workspace/thaddi run test:invite && pnpm --filter @workspace/thaddi run test:home && pnpm --filter @workspace/thaddi run test:account && pnpm --filter @workspace/thaddi run test:detail && pnpm --filter @workspace/api-server test"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 5173

[[ports]]
localPort = 18666
externalPort = 3002

[[ports]]
localPort = 20717
externalPort = 3001

[[ports]]
localPort = 22681
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BOOTSTRAP_ADMIN_EMAILS = "asof@me.com"
NOTIFICATIONS_FROM_EMAIL = "notifications@thaddi.app"
THADDI_APP_URL = "https://thaddi.app"
FOOTBALL_PROVIDER = "espn"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_AASLlUkgGAHvyEXtUrEdMAWGSlP"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_VtsanjlgdSlILiywIaoYYNCBdcz"
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_fOukxKLovuIcNYSsjcRdqFStXkO"
REVENUECAT_PROJECT_ID = "projf2c934a8"
REVENUECAT_TEST_STORE_APP_ID = "app3776a232c8"
REVENUECAT_APPLE_APP_STORE_APP_ID = "appd81555a8fe"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "appf2d74e02af"

[userenv.production]
DEMO_HARNESS_PROD_ENABLED = "true"
VITE_DEMO_HARNESS_PROD_ENABLED = "true"
